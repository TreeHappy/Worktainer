#!/bin/sh
# Create (or remove) the three networks that make up the sandbox topology.
#
# They are created here rather than by podman-compose because they need
# options the compose file cannot express:
#
#   ctrl  no default route      the control plane must not reach the internet
#   data  no default route      the devbox gets its default route from --route
#         --route default via   the devbox's *only* way out is the egress
#         the egress container  container at 10.89.1.2
#   wan   metric=100            the egress container prefers this default over
#                               the self-referential one the data network adds
#
# DNS is disabled on all three: containers address each other by static IP (so
# the ingress DNAT rules work), and the devbox's DNS is served by the egress
# container so name resolution travels the same path as the rest of its traffic.
set -eu

CTRL=sandbox-ctrl
DATA=sandbox-data
WAN=sandbox-wan

CTRL_SUBNET=10.89.0.0/24
DATA_SUBNET=10.89.1.0/24
WAN_SUBNET=10.89.2.0/24

EGRESS_DATA_IP=10.89.1.2

# The data network's default route is installed in every member. The egress
# container is a member (it holds 10.89.1.2), so it gets a route via itself;
# its entrypoint removes it and falls back to the wan default. The high metric
# keeps the wan default (metric 100) preferred in the window before that runs.
DATA_ROUTE_METRIC=1000

up() {
    if ! podman network exists "$CTRL"; then
        podman network create \
            --subnet "$CTRL_SUBNET" \
            --opt no_default_route=1 \
            --disable-dns \
            "$CTRL"
    fi

    if ! podman network exists "$DATA"; then
        podman network create \
            --subnet "$DATA_SUBNET" \
            --opt no_default_route=1 \
            --disable-dns \
            --route "0.0.0.0/0,$EGRESS_DATA_IP,$DATA_ROUTE_METRIC" \
            "$DATA"
    fi

    if ! podman network exists "$WAN"; then
        podman network create \
            --subnet "$WAN_SUBNET" \
            --opt metric=100 \
            --disable-dns \
            "$WAN"
    fi

    podman network ls --filter name=sandbox-
}

down() {
    for net in "$CTRL" "$DATA" "$WAN"; do
        if podman network exists "$net"; then
            podman network rm -f "$net"
        fi
    done
}

case "${1:-}" in
up) up ;;
down) down ;;
*)
    echo "usage: $0 {up|down}" >&2
    exit 2
    ;;
esac
