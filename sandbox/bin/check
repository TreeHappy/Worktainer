#!/bin/sh
# Acceptance checks for the sandbox.
#
# Every check is reported as PASS, FAIL or SKIP (SKIP means the thing being
# verified depends on something that is not running right now, e.g. an
# interactive session). The exit status is non-zero if anything failed.
#
# Run it with `bin/sandbox check`.
set -u

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sandbox=$(dirname -- "$here")      # .../sandbox, for the CA the checks compare against

pass=0
fail=0
skip=0

ok()   { pass=$((pass + 1)); printf 'PASS  %s\n' "$1"; }
bad()  { fail=$((fail + 1)); printf 'FAIL  %s\n' "$1"; [ $# -gt 1 ] && printf '      -> %s\n' "$2"; }
note() { skip=$((skip + 1)); printf 'SKIP  %s\n' "$1"; [ $# -gt 1 ] && printf '      -> %s\n' "$2"; }

# check <description> <command...>: PASS when the command exits 0.
check() {
    desc=$1
    shift
    if "$@" >/dev/null 2>&1; then ok "$desc"; else bad "$desc"; fi
}

echo "== networks =="
for net in sandbox-ctrl sandbox-data sandbox-wan; do
    check "$net exists" podman network exists "$net"
done

echo
echo "== containers =="
for name in sandbox-ingress sandbox-egress sandbox-devbox sandbox-openbao \
            sandbox-telemetry-o11ylite sandbox-telemetry-otel-desktop-viewer \
            sandbox-telemetry-otelop; do
    if podman ps --format '{{.Names}}' 2>/dev/null | grep -qx "$name"; then
        ok "$name is running"
    else
        bad "$name is running"
    fi
done

echo
echo "== the devbox only leaves through the egress =="
if podman exec sandbox-devbox ip route show default 2>/dev/null | grep -q 'via 10\.89\.1\.2'; then
    ok "devbox default route is via the egress (10.89.1.2)"
else
    bad "devbox default route is via the egress (10.89.1.2)" \
        "$(podman exec sandbox-devbox ip route show default 2>&1)"
fi

# The data network's --route also lands on the egress container itself; its
# entrypoint must delete that one, otherwise traffic prefers a loop back into
# itself. This is the first thing to check on a fresh host.
if podman exec sandbox-egress ip route show default 2>/dev/null | grep -q 'via 10\.89\.1\.2'; then
    bad "egress default route no longer points at itself" \
        "see README.md -> Troubleshooting, self-referential route"
else
    ok "egress default route no longer points at itself"
fi

if podman exec sandbox-devbox cat /etc/resolv.conf 2>/dev/null | grep -q '10\.89\.1\.2'; then
    ok "devbox DNS is the egress container"
else
    bad "devbox DNS is the egress container"
fi

echo
echo "== DNS and internet, from inside the devbox =="
if podman exec sandbox-devbox getent hosts example.com >/dev/null 2>&1; then
    ok "devbox resolves example.com through the egress"
else
    bad "devbox resolves example.com through the egress"
fi

code=$(podman exec sandbox-devbox curl -sS -o /dev/null -w '%{http_code}' \
        --max-time 15 https://example.com 2>/dev/null || true)
if [ "$code" = "200" ]; then
    ok "devbox reaches the internet (https://example.com -> 200)"
else
    bad "devbox reaches the internet" "got HTTP '$code'"
fi

echo
echo "== openbao, the secrets server =="
# The devbox's sshd-init fetches its authorized keys from openbao at boot, so
# the devbox has to be able to reach it across the data network. The health
# endpoint needs no token and answers 200 while the dev-mode server is active.
code=$(podman exec sandbox-devbox curl -sS -o /dev/null -w '%{http_code}' \
        --max-time 5 http://10.89.1.20:8200/v1/sys/health 2>/dev/null || true)
if [ "$code" = "200" ]; then
    ok "devbox reaches openbao (10.89.1.20:8200 -> 200)"
else
    bad "devbox reaches openbao" "got HTTP '$code'"
fi

echo
echo "== controllers =="
if podman exec sandbox-egress nft list ruleset 2>/dev/null | grep -q masquerade; then
    ok "egress masquerades on the WAN"
else
    bad "egress masquerades on the WAN"
fi

for counter in up down dns; do
    if podman exec sandbox-egress nft list counters 2>/dev/null \
        | grep -q "counter $counter"; then
        ok "egress counter '$counter' present"
    else
        bad "egress counter '$counter' present"
    fi
done

if podman exec sandbox-ingress nft list counters 2>/dev/null \
    | grep -q 'counter forwarded'; then
    ok "ingress counter 'forwarded' present"
else
    bad "ingress counter 'forwarded' present"
fi

if podman exec sandbox-ingress nft list ruleset 2>/dev/null | grep -q 'dnat'; then
    ok "ingress has DNAT rules"
else
    bad "ingress has DNAT rules"
fi

if podman exec sandbox-ingress tc qdisc show 2>/dev/null | grep -q tbf; then
    ok "ingress shapes the devbox-facing link (tbf)"
else
    bad "ingress shapes the devbox-facing link (tbf)"
fi

if podman exec sandbox-egress tc qdisc show 2>/dev/null | grep -q tbf; then
    ok "egress shapes both links (tbf)"
else
    bad "egress shapes both links (tbf)"
fi

# The auth-injecting proxy: all three have to be true or the devbox's https is
# either intercepted with nothing listening or trusted by nobody.
if podman exec sandbox-egress pgrep -f mitmdump >/dev/null 2>&1; then
    ok "egress runs the auth proxy (mitmdump)"
else
    bad "egress runs the auth proxy (mitmdump)" \
        "see 'bin/sandbox logs egress' and egress/README.md -> Troubleshooting"
fi

if podman exec sandbox-egress nft list counters 2>/dev/null \
    | grep -q 'counter proxied'; then
    ok "egress counter 'proxied' present"
else
    note "egress counter 'proxied' present" \
        "HEADER_JOBS is empty, so outbound https is not intercepted at all"
fi

if podman exec sandbox-egress nft list ruleset 2>/dev/null \
    | grep -q 'redirect to :8080'; then
    ok "egress redirects the devbox's https to the proxy"
else
    bad "egress redirects the devbox's https to the proxy"
fi

# The devbox trusts the sandbox CA, which is what lets the proxy present a
# certificate the devbox accepts. devbox-init appends the mounted certificate to
# the system bundle at every start, so this is about the *running* container's
# trust store, not the image's.
#
# By asking openssl to verify the mounted certificate against the system bundle,
# not by looking for a subject. The audit found that "some CA called sandbox-ca
# is trusted" passes for a CA that no longer matches the one the proxy signs
# with (S7): every intercepted request then fails certificate verification and
# the check still says PASS.
#
# Two things tried here first and abandoned, both of which would have been wrong
# in a way that looks right:
#   * matching on the subject, which is the S7 bug itself;
#   * comparing `get_ca_certs()[i]["fingerprint"]` in python, which on 3.14
#     exposes no fingerprint at all - only issuer, subject, serial and dates -
#     so the comparison never matches and the check always FAILs.
# openssl is what actually does the verification in the container, so ask it.
ca_fingerprint=$(openssl x509 -in "$sandbox/ca/sandbox-ca.crt" -noout -sha256 -fingerprint 2>/dev/null |
    sed 's/.*=//; s/://g')
ca_fingerprint_tail=$(printf '%s' "$ca_fingerprint" | cut -c17-32)
if [ -z "$ca_fingerprint" ]; then
    note "devbox trusts the sandbox CA" \
        "no $sandbox/ca/sandbox-ca.crt (run bin/sandbox ca)"
elif podman exec sandbox-devbox openssl verify -no-CAfile -no-CApath \
    -trusted /etc/ssl/certs/ca-certificates.crt \
    /etc/sandbox/ca/sandbox-ca.crt >/dev/null 2>&1; then
    ok "devbox trusts the sandbox CA (sha256 $ca_fingerprint_tail)"
else
    bad "devbox trusts the sandbox CA (sha256 $ca_fingerprint_tail)" \
        "the devbox does not trust this certificate (sha256 $ca_fingerprint_tail). Either the image predates the current CA - rebuild it - or devbox-init could not append the mounted one; see bin/sandbox logs devbox"
fi

# S1: the devbox must not hold a token that can reach anything but its own
# authorized_keys. This is the check that would have caught the original
# finding, and the one that stops it coming back.
#
# It asks the vault, from the devbox's own token, for the two things that must
# not be reachable: the provider key, and a write to its own key list.
echo
echo "== the devbox's vault token is scoped (audit S1) =="
devbox_token=$(podman exec sandbox-devbox cat /vault/devbox.token 2>/dev/null || true)
if [ -z "$devbox_token" ]; then
    note "devbox token cannot read the provider keys" \
        "no /vault/devbox.token in the devbox (is sandbox-openbao healthy? bin/sandbox logs openbao)"
    note "devbox token cannot write its own authorized_keys" \
        "no /vault/devbox.token in the devbox"
else
    for forbidden in 'secret/data/egress/anthropic' 'secret/data/egress/openai'; do
        code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 \
               -H "X-Vault-Token: $devbox_token" \
               "http://10.89.1.20:8200/v1/$forbidden" 2>/dev/null || true)
        if [ "$code" = "403" ]; then
            ok "devbox token cannot read $forbidden (403)"
        else
            bad "devbox token cannot read $forbidden" \
                "got HTTP ${code:-no response} - the devbox holds a token that is not scoped to its own secret (audit S1)"
        fi
    done

    code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 \
           -X POST -H "X-Vault-Token: $devbox_token" -H 'Content-Type: application/json' \
           -d '{"data":{"authorized_keys":"ssh-ed25519 AAAA bin-check-probe"}}' \
           "http://10.89.1.20:8200/v1/secret/data/devbox/authorized_keys" 2>/dev/null || true)
    if [ "$code" = "403" ]; then
        ok "devbox token cannot write its own authorized_keys (403)"
    else
        bad "devbox token cannot write its own authorized_keys" \
            "got HTTP ${code:-no response} - the agent could add its own SSH key"
    fi

    # And the same token must not be the root token, which is the whole point.
    code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 \
           -H "X-Vault-Token: $devbox_token" \
           "http://10.89.1.20:8200/v1/sys/mounts" 2>/dev/null || true)
    if [ "$code" = "403" ]; then
        ok "devbox token is not a root token (sys/mounts is 403)"
    else
        bad "devbox token is not a root token" \
            "sys/mounts returned HTTP ${code:-no response}; this looks like the root token"
    fi
fi

echo
echo "== reaching the sandbox from the host =="
for port in 9419 9420 9421; do
    desc="host port $port reaches a telemetry UI through the ingress"
    if command -v curl >/dev/null 2>&1; then
        code=$(curl -sS -o /dev/null -w '%{http_code}' \
               --max-time 10 "http://127.0.0.1:$port/" 2>/dev/null || true)
        case "$code" in
            000|"") bad "$desc" "connection failed (code '$code')" ;;
            *) ok "$desc (HTTP $code)" ;;
        esac
    else
        note "$desc" "curl is not installed on this host"
    fi
done

# 8080 forwards to a demo listener in the devbox; there is none by default.
if command -v curl >/dev/null 2>&1; then
    code=$(curl -sS -o /dev/null -w '%{http_code}' \
           --max-time 5 "http://127.0.0.1:8080/" 2>/dev/null || true)
    case "$code" in
        000|"") note "host port 8080 -> devbox" \
                    "no listener: start one with bin/sandbox shell devbox" ;;
        *)      ok "host port 8080 -> devbox (HTTP $code)" ;;
    esac
else
    note "host port 8080 -> devbox" "curl is not installed on this host"
fi

# OpenBao's API and web UI. /v1/sys/health needs no token and answers 200 as
# long as the dev-mode server is active.
if command -v curl >/dev/null 2>&1; then
    code=$(curl -sS -o /dev/null -w '%{http_code}' \
           --max-time 10 "http://127.0.0.1:8200/v1/sys/health" 2>/dev/null || true)
    case "$code" in
        200) ok "host port 8200 reaches openbao (/v1/sys/health -> 200)" ;;
        000|"") bad "host port 8200 reaches openbao" \
                     "connection failed (code '$code')" ;;
        *) bad "host port 8200 reaches openbao" "got HTTP '$code'" ;;
    esac
else
    note "host port 8200 reaches openbao" "curl is not installed on this host"
fi

# The devbox ships an sshd (started by sandbox-devbox.container, listening on
# 2222 inside the container). Its authorized keys come from OpenBao, so this
# checks the listener and the key list — not a login, which needs a user key.
check "devbox sshd listens inside the container on 2222" \
    podman exec sandbox-devbox \
    bash -c 'exec 3<>/dev/tcp/127.0.0.1/2222'

if podman exec sandbox-devbox test -s /home/dev/.ssh/authorized_keys 2>/dev/null; then
    ok "devbox authorized_keys provisioned from openbao"
else
    note "devbox authorized_keys provisioned from openbao" \
         "store keys in secret/devbox/authorized_keys, then bin/sandbox exec devbox sshd-init"
fi

echo
echo "== telemetry =="
if command -v curl >/dev/null 2>&1; then
    for ep in "10.89.0.20 80" "10.89.0.21 8000" "10.89.0.22 4319"; do
        set -- $ep
        ip=$1
        port=$2
        # Ask from inside the ingress, which is on the control network; this
        # is the path the controllers use to reach the backends.
        if podman exec sandbox-ingress curl -sS -o /dev/null -w '%{http_code}' \
            --max-time 10 "http://$ip:$port/" 2>/dev/null \
            | grep -qE '^(200|301|302|303|307|308)$'; then
            ok "control network reaches http://$ip:$port"
        else
            bad "control network reaches http://$ip:$port"
        fi
    done
else
    note "telemetry backends reachable on the control network" \
         "curl is not installed on this host"
fi

echo
printf 'passed=%d failed=%d skipped=%d\n' "$pass" "$fail" "$skip"
[ "$fail" -eq 0 ]
