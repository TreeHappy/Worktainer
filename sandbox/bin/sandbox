#!/bin/sh
# Drive the sandbox: the three networks plus the podman-compose stack.
#
# Usage: sandbox <command> [args]
#
#   dev-sync           copy the root mise.toml + dotfile sources into sandbox/dev/
#   networks up|down   create/remove the three networks (needed before `up`)
#   config             render and validate the compose file
#   build              dev-sync + build the images
#   up                 networks up + build + start everything (detached)
#   down               stop and remove the containers (keeps the networks)
#   clean              down + remove volumes, images and networks
#   ps                 list the sandbox containers
#   logs [service]     follow logs (all services, or one)
#   shell [service]    open a shell (default: devbox)
#   exec <service> cmd run a command in a container
#   rules [service]    print the nftables ruleset a controller would install
#   nft [service]      show the live nftables ruleset of a running controller
#   check              run the acceptance checks in bin/check
#
# Everything runs rootless; nothing here needs sudo.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sandbox=$(dirname -- "$here")      # .../sandbox
repo=$(dirname -- "$sandbox")      # repository root
compose="$sandbox/compose.yaml"
project=sandbox

# What the devbox image is built from. These are copies of the repo-root
# sources: the root copies are the ones to edit, `dev-sync` refreshes these.
DEV_ITEMS="mise.toml bashrc starship.toml atuin bat eza hunk jjui lazygit leaf opencode pi procs workmux yazi zellij"

compose_cmd() {
    podman-compose -p "$project" -f "$compose" "$@"
}

usage() {
    cat <<EOF
sandbox - a devbox that can only reach the network through its controllers

Usage: $(basename "$0") <command> [args]

  dev-sync           copy the root mise.toml + dotfile sources into sandbox/dev/
  networks up|down   create/remove the three networks (needed before \`up\`)
  config             render and validate the compose file
  build              dev-sync + build the images
  up                 networks up + build + start everything (detached)
  down               stop and remove the containers (keeps the networks)
  clean              down + remove volumes, images and networks
  ps                 list the sandbox containers
  logs [service]     follow logs (all services, or one)
  shell [service]    open a shell (default: devbox)
  exec <service> cmd run a command in a container
  rules [service]    print the nftables ruleset a controller would install
  nft [service]      show the live nftables ruleset of a running controller
  check              run the acceptance checks

See sandbox/README.md for the topology.
EOF
}

# Refresh the devbox build context from the repo root.
dev_sync() {
    dest="$sandbox/dev"
    mkdir -p "$dest"

    for item in $DEV_ITEMS; do
        if [ ! -e "$repo/$item" ]; then
            echo "dev-sync: warning: $repo/$item no longer exists" >&2
            continue
        fi
        rm -rf "$dest/$item"
        cp -a "$repo/$item" "$dest/"
    done

    # Drop anything that has since disappeared from the root, so the build
    # context never keeps a dotfile the repo no longer has. Dockerfile and
    # README.md belong to this folder and are always kept.
    for entry in "$dest"/*; do
        [ -e "$entry" ] || continue
        base=$(basename -- "$entry")
        case " Dockerfile README.md $DEV_ITEMS " in
            *" $base "*) ;;
            *)
                rm -rf "$entry"
                echo "dev-sync: removed $base (gone from the repo root)"
                ;;
        esac
    done

    echo "dev-sync: $dest refreshed from $repo"
}

case "${1:-}" in
dev-sync)
    dev_sync
    ;;
networks)
    shift
    exec "$here/networks" "$@"
    ;;
config)
    compose_cmd config
    ;;
build)
    dev_sync
    compose_cmd build
    ;;
up)
    dev_sync
    "$here/networks" up
    compose_cmd build
    compose_cmd up -d
    compose_cmd ps
    ;;
down)
    compose_cmd down
    ;;
clean)
    compose_cmd down --volumes --rmi local 2>/dev/null || compose_cmd down -v
    "$here/networks" down
    ;;
ps)
    compose_cmd ps
    ;;
logs)
    shift
    compose_cmd logs -f "$@"
    ;;
shell)
    service=${2:-devbox}
    exec podman exec -it "sandbox-$service" /bin/bash 2>/dev/null \
        || exec podman exec -it "sandbox-$service" /bin/sh
    ;;
exec)
    shift
    service=$1
    shift
    exec podman exec -it "sandbox-$service" "$@"
    ;;
rules)
    service=${2:-egress}
    if podman ps --format '{{.Names}}' 2>/dev/null | grep -qx "sandbox-$service"; then
        exec podman exec -e DRY_RUN=1 "sandbox-$service" /usr/local/bin/entrypoint.sh
    fi
    DRY_RUN=1 sh "$sandbox/$service/entrypoint.sh"
    ;;
nft)
    service=${2:-egress}
    exec podman exec -it "sandbox-$service" nft list ruleset
    ;;
check)
    exec "$here/check"
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
