#!/bin/sh
# Drive the sandbox: the three networks plus the podman-compose stack.
#
# Usage: sandbox <command> [args]
#
#   networks up|down   create/remove the three networks (needed before `up`)
#   config             render and validate the compose file
#   build              build the images
#   up                 networks up + build + start everything (detached)
#   down               stop and remove the containers (keeps the networks)
#   clean              down + remove volumes, images and networks
#   ps                 list the sandbox containers
#   logs [service]     follow logs (all services, or one)
#   shell [service]    open a shell (default: devbox)
#   exec <service> cmd run a command in a container
#   rules [service]    print the nftables ruleset a controller would install
#   nft [service]      show the live nftables ruleset of a running controller
#   check              run the acceptance checks in bin/check
#
# Everything runs rootless; nothing here needs sudo.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sandbox=$(dirname -- "$here")      # .../sandbox
compose="$sandbox/compose.yaml"
project=sandbox

# The devbox image builds from the repository root (compose sets the context
# and Dockerfile), so it COPYies the repo's dotfiles/ folder and
# sandbox/dev/mise.toml directly — there is no mirrored copy of the sources to
# refresh.

compose_cmd() {
    podman-compose -p "$project" -f "$compose" "$@"
}

usage() {
    cat <<EOF
sandbox - a devbox that can only reach the network through its controllers

Usage: $(basename "$0") <command> [args]

  networks up|down   create/remove the three networks (needed before \`up\`)
  config             render and validate the compose file
  build              build the images
  up                 networks up + build + start everything (detached)
  down               stop and remove the containers (keeps the networks)
  clean              down + remove volumes, images and networks
  ps                 list the sandbox containers
  logs [service]     follow logs (all services, or one)
  shell [service]    open a shell (default: devbox)
  exec <service> cmd run a command in a container
  rules [service]    print the nftables ruleset a controller would install
  nft [service]      show the live nftables ruleset of a running controller
  check              run the acceptance checks

See sandbox/README.md for the topology.
EOF
}

case "${1:-}" in
networks)
    shift
    exec "$here/networks" "$@"
    ;;
config)
    compose_cmd config
    ;;
build)
    compose_cmd build
    ;;
up)
    "$here/networks" up
    compose_cmd build
    compose_cmd up -d
    compose_cmd ps
    ;;
down)
    compose_cmd down
    ;;
clean)
    compose_cmd down --volumes --rmi local 2>/dev/null || compose_cmd down -v
    "$here/networks" down
    ;;
ps)
    compose_cmd ps
    ;;
logs)
    shift
    compose_cmd logs -f "$@"
    ;;
shell)
    service=${2:-devbox}
    exec podman exec -it "sandbox-$service" /bin/bash 2>/dev/null \
        || exec podman exec -it "sandbox-$service" /bin/sh
    ;;
exec)
    shift
    service=$1
    shift
    exec podman exec -it "sandbox-$service" "$@"
    ;;
rules)
    service=${2:-egress}
    if podman ps --format '{{.Names}}' 2>/dev/null | grep -qx "sandbox-$service"; then
        exec podman exec -e DRY_RUN=1 "sandbox-$service" /usr/local/bin/entrypoint.sh
    fi
    DRY_RUN=1 sh "$sandbox/$service/entrypoint.sh"
    ;;
nft)
    service=${2:-egress}
    exec podman exec -it "sandbox-$service" nft list ruleset
    ;;
check)
    exec "$here/check"
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
