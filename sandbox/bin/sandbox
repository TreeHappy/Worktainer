#!/bin/sh
# Drive the sandbox: nix builds the images, systemd runs the containers.
#
# Usage: sandbox <command> [args]
#
#   ca                 create the sandbox CA (sandbox/ca/) if it is missing
#   link               link the quadlet units into ~/.config/containers/systemd
#   unlink             remove those links
#   build              build the images with nix and load them into podman
#   up                 link + build + start everything
#   down               stop and remove the containers (keeps the volumes)
#   clean              down + remove the volumes and the images
#   ps                 what systemd thinks is running
#   logs [service]     follow logs (all services, or one)
#   shell [service]    open a shell (default: devbox)
#   exec <service> cmd run a command in a container
#   rules [service]    print the nftables ruleset a controller would install
#   nft [service]      show the live nftables ruleset of a running controller
#   check              run the acceptance checks in bin/check
#
# Everything runs rootless; nothing here needs sudo.
#
# There is no compose file and no podman-compose. The units in sandbox/quadlet/
# are the whole definition, systemd owns the ordering, and `nft build` owns the
# images. What is left here is the part that is not either: the CA, and the
# commands that want to be typed.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sandbox=$(dirname -- "$here")      # .../sandbox
repo=$(dirname -- "$sandbox")       # .../
quadlet=$sandbox/quadlet

# Where rootless Quadlet reads per-user units. It follows symlinks both for a
# search path and inside one, so linking the files individually is enough — and
# individual links leave room for a drop-in next to them that a re-link does not
# clobber.
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/containers/systemd

# The devbox is the default for everything that takes a service name.
default_service=devbox

# Container name for a service. Every unit sets ContainerName=, so this is a
# lookup rather than a construction — but keeping it in one place means a
# rename in one file does not silently point the wrong command at a container.
container() {
    printf 'sandbox-%s' "$1"
}

# --------------------------------------------------------------------------
# The sandbox CA.
#
# The root certificate the egress's proxy signs with. The devbox is handed it at
# container start from a read-only bind mount, so it is never baked into an
# image and never reaches the nix store — see nix/lib/image.nix and
# sandbox/dev/devbox-init.sh. Generated per machine and never committed
# (sandbox/ca/ is in .gitignore). See ca/README.md and egress/README.md.
# --------------------------------------------------------------------------
ca_crt=$sandbox/ca/sandbox-ca.crt
ca_key=$sandbox/ca/sandbox-ca.key

ensure_ca() {
    if [ -f "$ca_crt" ] && [ -f "$ca_key" ]; then
        return 0
    fi
    mkdir -p "$sandbox/ca"
    # An EC P-256 root: signing is cheap, and nothing here cares about the
    # algorithm beyond it being a certificate a TLS stack will accept.
    openssl req -x509 -newkey ec \
        -pkeyopt ec_paramgen_curve:prime256v1 -nodes -sha256 -days 3650 \
        -keyout "$ca_key" -out "$ca_crt" \
        -subj "/O=sandbox/CN=sandbox-ca" \
        -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
        -addext "keyUsage=critical,keyCertSign,cRLSign" \
        -addext "subjectKeyIdentifier=hash" >/dev/null
    chmod 600 "$ca_key"
    chmod 644 "$ca_crt"
    printf 'ca: created %s\n' "$ca_crt"
}

# --------------------------------------------------------------------------
# Units.
#
# `link` is separate from `up` so an edit to a unit file is a re-link and a
# daemon-reload rather than a rebuild, and so a machine can link once at
# `home-manager switch` time and never think about it again.
# --------------------------------------------------------------------------
link_units() {
    mkdir -p "$unit_dir"
    for src in "$quadlet"/*.network "$quadlet"/*.container "$quadlet"/*.volume; do
        [ -e "$src" ] || continue
        name=$(basename "$src")
        # Replace a link that points somewhere else (a moved checkout), and
        # leave a real file alone: that would be a hand-written override.
        if [ -L "$unit_dir/$name" ] && [ "$(readlink "$unit_dir/$name")" != "$src" ]; then
            rm -f "$unit_dir/$name"
        fi
        [ -e "$unit_dir/$name" ] || ln -s "$src" "$unit_dir/$name"
    done
    systemctl --user daemon-reload
    printf 'units: %d linked into %s\n' \
        "$(find "$unit_dir" -maxdepth 1 -name 'sandbox-*' | wc -l)" "$unit_dir"
}

unlink_units() {
    for src in "$quadlet"/*.network "$quadlet"/*.container "$quadlet"/*.volume; do
        [ -e "$src" ] || continue
        name=$(basename "$src")
        # Only remove links we made. A hand-placed file in ~/.config is not
        # ours to delete.
        if [ -L "$unit_dir/$name" ] && [ "$(readlink "$unit_dir/$name")" = "$src" ]; then
            rm -f "$unit_dir/$name"
        fi
    done
    systemctl --user daemon-reload 2>/dev/null || true
    printf 'units: unlinked\n'
}

# --------------------------------------------------------------------------
# Images.
#
# nix build produces a docker-format tarball per image, which is what
# `podman load` takes. The four upstream images (openbao and the three
# telemetry backends) are pulled by podman on first start and are not built
# here.
# --------------------------------------------------------------------------
build_images() {
    for image in sandbox-ingress sandbox-egress sandbox-devbox; do
        printf 'build: %s\n' "$image"
        tarball=$(nix build --no-link --print-out-paths \
            "$repo#${image}") || return 1
        podman load --input "$tarball" >/dev/null || return 1
    done
    printf 'build: done\n'
}

# Every unit that makes up the stack, in the order systemd will sort them
# anyway. Used for `up` (start them all) and `down` (stop them all); the
# individual Requires=/After= in the units is what actually orders them.
units() {
    printf '%s\n' \
        sandbox-telemetry-o11ylite.service \
        sandbox-telemetry-otel-desktop-viewer.service \
        sandbox-telemetry-otelop.service \
        sandbox-openbao.service \
        sandbox-ingress.service \
        sandbox-egress.service \
        sandbox-devbox.service
}

service_unit() {
    # A service name is `devbox`, `egress`, ...; the unit is
    # sandbox-<name>.service. Networks are named the same way.
    case "$1" in
        *.service | *.network) printf '%s\n' "$1" ;;
        *) container "$1"; printf '.service\n' ;;
    esac
}

usage() {
    cat <<EOF
sandbox - a devbox that can only reach the network through its controllers

Usage: $(basename "$0") <command> [args]

  ca                 create the sandbox CA (sandbox/ca/) if it is missing
  link               link the quadlet units into ~/.config/containers/systemd
  unlink             remove those links
  build              build the images with nix and load them into podman
  up                 link + build + start everything
  down               stop and remove the containers (keeps the volumes)
  clean              down + remove the volumes and the images
  ps                 what systemd thinks is running
  logs [service]     follow logs (all services, or one)
  shell [service]    open a shell (default: devbox)
  exec <service> cmd run a command in a container
  rules [service]    print the nftables ruleset a controller would install
  nft [service]      show the live nftables ruleset of a running controller
  check              run the acceptance checks

See sandbox/README.md for the topology.
EOF
}

case "${1:-}" in
ca)
    if [ -f "$ca_crt" ] && [ -f "$ca_key" ]; then
        printf 'ca: %s already exists, keeping it (delete both to regenerate)\n' \
            "$ca_crt"
    else
        ensure_ca
    fi
    openssl x509 -in "$ca_crt" -noout -subject -fingerprint -sha256
    ;;
link)
    link_units
    ;;
unlink)
    unlink_units
    ;;
build)
    ensure_ca
    build_images
    ;;
up)
    ensure_ca
    link_units
    build_images
    # Starting the devbox pulls in everything it depends on, and the telemetry
    # backends are Wants=ed by the ingress, so this one line is the whole
    # startup. Listing them anyway makes the failure mode obvious when one of
    # them is not running.
    systemctl --user start $(units)
    systemctl --user --no-pager status $(units) || true
    ;;
down)
    systemctl --user stop $(units) 2>/dev/null || true
    ;;
clean)
    systemctl --user stop $(units) 2>/dev/null || true
    # The volumes are .volume units now; deleting the network units is their
    # NetworkDeleteOnStop=true, which already happened above.
    #
    # sandbox-vault goes with them: it holds the scoped OpenBao tokens, which are
    # worthless once the server that minted them is gone, but are worth removing
    # all the same rather than leaving a file of credentials on disk.
    for volume in o11ylite-data otel-desktop-viewer-data otelop-data sandbox-vault; do
        podman volume rm -f "$volume" 2>/dev/null || true
    done
    systemctl --user stop \
        o11ylite-data-volume.service \
        otel-desktop-viewer-data-volume.service \
        otelop-data-volume.service \
        sandbox-vault-volume.service 2>/dev/null || true
    for image in sandbox-ingress sandbox-egress sandbox-devbox; do
        podman rmi -f "localhost/$image:latest" 2>/dev/null || true
    done
    ;;
ps)
    systemctl --user --no-pager list-units 'sandbox-*' --all
    ;;
logs)
    shift
    if [ $# -eq 0 ]; then
        exec journalctl --user --follow -u 'sandbox-*'
    fi
    exec journalctl --user --follow -u "$(service_unit "$1")"
    ;;
shell)
    service=${2:-$default_service}
    exec podman exec -it "$(container "$service")" /bin/bash 2>/dev/null \
        || exec podman exec -it "$(container "$service")" /bin/sh
    ;;
exec)
    shift
    service=$1
    shift
    exec podman exec -it "$(container "$service")" "$@"
    ;;
rules)
    # The same env file the container is given, so what is printed here is what
    # gets installed in there — not the entrypoint's defaults, which can drift.
    service=${2:-egress}
    env_file=$quadlet/environments/$service.env
    if [ -f "$env_file" ]; then
        set -a
        # shellcheck disable=SC1090
        . "$env_file"
        set +a
    fi
    if podman ps --format '{{.Names}}' 2>/dev/null | grep -qx "$(container "$service")"; then
        DRY_RUN=1 exec podman exec -e DRY_RUN=1 "$(container "$service")" \
            /usr/local/bin/entrypoint.sh
    fi
    DRY_RUN=1 exec sh "$sandbox/$service/entrypoint.sh"
    ;;
nft)
    service=${2:-egress}
    exec podman exec -it "$(container "$service")" nft list ruleset
    ;;
check)
    exec "$here/check"
    ;;
*)
    usage >&2
    exit 2
    ;;
esac