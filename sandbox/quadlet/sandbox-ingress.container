# sandbox-ingress: the only way into the sandbox from the host.
#
# Replaces the `ingress` service in sandbox/compose.yaml. The image is built by
# nix (nix/images/ingress.nix) and loaded by `bin/sandbox build`, so this file
# starts with Image= rather than build:.
#
# What it does, and how to steer it, is in sandbox/ingress/README.md.

[Unit]
Description=sandbox ingress controller
# Only "start this first", which is all compose's depends_on meant: the DNAT
# rules are installed whether or not a telemetry UI is listening. Wants= rather
# than Requires= so a backend that fails to start does not take the controller
# down with it.
Wants=sandbox-telemetry-o11ylite.service
Wants=sandbox-telemetry-otel-desktop-viewer.service
Wants=sandbox-telemetry-otelop.service
After=sandbox-telemetry-o11ylite.service
After=sandbox-telemetry-otel-desktop-viewer.service
After=sandbox-telemetry-otelop.service

[Container]
ContainerName=sandbox-ingress
Image=localhost/sandbox-ingress:latest
HostName=ingress

# Per-network addresses, carried by the network they belong to. Quadlet's IP=
# would be a bare `podman run --ip`, which podman applies to a single network —
# and this container is on two. See sandbox/quadlet/README.md.
Network=sandbox-ctrl.network:ip=10.89.0.3
Network=sandbox-data.network:ip=10.89.1.3

# The only way the host reaches the sandbox. Loopback-bound: nothing outside
# this machine has any business reaching the devbox's sshd, or OpenBao with its
# fixed dev-mode root token (audit S5). The ingress DNATs each of these to its
# backend regardless of the bind address.
PublishPort=127.0.0.1:2222:2222
PublishPort=127.0.0.1:8080:8080
PublishPort=127.0.0.1:8200:8200
PublishPort=127.0.0.1:9419:9419
PublishPort=127.0.0.1:9420:9420
PublishPort=127.0.0.1:9421:9421

# Port DNAT needs NET_ADMIN and raw sockets for the packets it inspects.
AddCapability=CAP_NET_ADMIN CAP_NET_RAW

# Forwarding is the job.
Sysctl=net.ipv4.ip_forward=1

DNS=9.9.9.9

EnvironmentFile=environments/ingress.env

# Isolation, from the findings in todo/compare/06-workload-and-isolation.md.
# A controller needs its capabilities and little else.
NoNewPrivileges=true
DropCapability=CAP_AUDIT_WRITE CAP_MKNOD CAP_NET_BIND_SERVICE CAP_SETFCAP CAP_SETGID CAP_SETPCAP CAP_SYS_CHROOT CAP_SYS_PTRACE
PidsLimit=256
Memory=512M

[Service]
Restart=always
# A cold start may pull the image; systemd's 90s default is not much for that.
TimeoutStartSec=900