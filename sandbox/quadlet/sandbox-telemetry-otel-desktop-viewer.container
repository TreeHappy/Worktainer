# sandbox-telemetry-otel-desktop-viewer: one of three span stores.
#
# Replaces the `telemetry-otel-desktop-viewer` service in sandbox/compose.yaml.
# Its flags were a compose `command:`, which becomes Exec= here.
#
#   --db /data/otel-desktop-viewer.duckdb   keep the DuckDB file on the volume
#                                          instead of the default in-memory store,
#                                          so the spans survive a restart
#   --open-browser=false                   do not try to launch a browser
#
# The image is upstream and pulled rather than built here — see nix/README.md.

[Unit]
Description=sandbox telemetry: otel-desktop-viewer

[Container]
ContainerName=sandbox-telemetry-otel-desktop-viewer
Image=localhost/sandbox-telemetry-otel-desktop-viewer:latest
HostName=telemetry-otel-desktop-viewer

Network=sandbox-ctrl.network:ip=10.89.0.21

Volume=otel-desktop-viewer-data.volume:/data

Exec=--host 0.0.0.0 --grpc 4317 --http 4318 --browser-port 8000 --open-browser=false --db /data/otel-desktop-viewer.duckdb

NoNewPrivileges=true
DropCapability=ALL
PidsLimit=256
Memory=1G

[Service]
Restart=always
TimeoutStartSec=900
