# sandbox-egress, read by sandbox-egress.container via EnvironmentFile=.
#
# One source of truth: the entrypoint has a default for every one of these, but
# this file is what the container actually gets, and `bin/sandbox rules egress`
# reads this same file.
#
# systemd env-file syntax: KEY=value, no quoting, `#` starts a comment.

# This container's own addresses, on all three of its networks. WAN_GW is only
# used if the wan default route is missing, which it should not be.
CTRL_IP=10.89.0.2
DATA_IP=10.89.1.2
WAN_IP=10.89.2.2
WAN_GW=10.89.2.1

# tc shaping: the WAN link caps the upload, the data link caps what the devbox
# can pull down. netem delay and loss on top.
UP_RATE=100mbit
DOWN_RATE=100mbit
DELAY=0ms
LOSS=0%

DNS_UPSTREAM=9.9.9.9

# Auth injection (see egress/README.md). The proxy decrypts the devbox's
# outbound https in order to set these headers, which it re-reads from OpenBao
# every BAO_RESYNC seconds. Empty means the proxy is not armed at all and the
# devbox's https goes straight out.
#
# One job per secret: "<host> bao:<mount>/<path>". They are separated by
# semicolons because a systemd env file cannot hold a multi-line value and this
# value needs two entries — and the whole value is quoted because `bin/sandbox
# rules` reads this same file with the shell, where an unquoted `;` would be a
# command separator. systemd, podman's --env-file and the shell all agree on
# the quotes.
#
# (compose's folded scalar put both jobs on one space-separated line, which
# parse_jobs rejected as malformed, so both were silently dropped until this was
# written down.)
HEADER_JOBS="api.anthropic.com bao:secret/egress/anthropic;api.openai.com bao:secret/egress/openai"

BAO_ADDR=http://10.89.1.20:8200
BAO_TOKEN=sandbox-root-token
BAO_RESYNC=300

OTEL_SERVICE_NAME=sandbox-egress
OTEL_ENDPOINTS="http://10.89.0.20/v1/traces http://10.89.0.21:4318/v1/traces http://10.89.0.22:4318/v1/traces"
