# sandbox-ingress, read by sandbox-ingress.container via EnvironmentFile=.
#
# One source of truth: the entrypoint has a default for every one of these, but
# this file is what the container actually gets, and `bin/sandbox rules ingress`
# reads this same file — so the ruleset printed on the host is the one that gets
# installed in the container.
#
# systemd env-file syntax: KEY=value, no quoting, `#` starts a comment.

# This container's own addresses. The interfaces are found by address rather
# than by name, because podman does not promise an order when a container joins
# several networks.
CTRL_IP=10.89.0.3
DATA_IP=10.89.1.3

# host-port:target-ip:target-port, one space-separated list. The host ports are
# published in the unit file; each is DNAT'd here to a sandbox container. The
# 2222 pair forwards to the sshd the devbox image ships, which listens on 2222
# inside the devbox (an unprivileged sshd cannot bind 22).
FORWARDS="2222:10.89.1.10:2222 8080:10.89.1.10:8080 8200:10.89.1.20:8200 9419:10.89.0.20:80 9420:10.89.0.21:8000 9421:10.89.0.22:4319"

# tc shaping on the devbox-facing link: tbf rate, netem delay, netem loss.
RATE=100mbit
DELAY=0ms
LOSS=0%

# Counters go out as OTel spans.
OTEL_SERVICE_NAME=sandbox-ingress
OTEL_ENDPOINTS="http://10.89.0.20/v1/traces http://10.89.0.21:4318/v1/traces http://10.89.0.22:4318/v1/traces"
