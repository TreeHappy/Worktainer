# sandbox-devbox: a developer's environment with every packet in and out
# crossing a controller.
#
# Replaces sandbox/dev/Dockerfile. This is the expensive one, and the only one
# with a real risk in it — a developer's environment is bash- and $HOME-shaped,
# and everything that makes it useful depends on that.
#
# ## The one thing that makes this image different
#
# The controllers are plain `dockerTools.buildLayeredImage`: everything in them
# runs as root, which is what a controller wants anyway.
#
# The devbox needs a uid-1000 `dev` that *owns* its home, because sshd refuses
# to start when the account, its ~/.ssh and its host key are not owned by that
# account — and running sshd is most of what the devbox is for. A layered image
# normally cannot express that: it copies each content with `rsync --chown=0:0`
# and tars with `--owner=0 --group=0`, so every file is root's.
#
# `uid`/`gid` on `buildLayeredImage` set the owner of the whole layer, and that
# is the escape hatch: the layer is built root-side and *tarred* as 1000:1000,
# so `dev` owns /home/dev, ~/.ssh and its host key. Nothing else in this image
# runs as root, so the fact that /nix and /etc belong to `dev` too is untidy
# rather than dangerous.
#
# (`buildImage` was the other candidate and has no ownership mechanism in this
# nixpkgs — the evaluator rejects `fakeRootCommands`.)
#
# ## The seven devbox problems, and what happened to each
#
#   1. a real `dev` at uid 1000   the layer's owner, plus an /etc/passwd entry.
#                                  sshd looks the account up before anything
#                                  else, and an unresolvable user is a start
#                                  failure, not a warning
#   2. the CA trust path          the public roots sit at
#                                  /etc/ssl/certs/ca-certificates.crt, and
#                                  devbox-init appends the sandbox CA from the
#                                  read-only bind mount at every start. No
#                                  `update-ca-certificates` run as uid 1000,
#                                  which was audit S6 and is why the old image
#                                  did not build at all
#   3. sshd's location            unchanged: config and host key under
#                                  ~/.ssh/sshd, port 2222
#   4. bash as the shell          unchanged, and deliberately so: the whole
#                                  config tree is written for bash
#   5. NODE_EXTRA_CA_CERTS        still /etc/ssl/certs/ca-certificates.crt,
#                                  which is where nixpkgs puts it
#   6. bat cache --build          gone. The theme is a file in the image rather
#                                  than a compile step, so there is no cache to
#                                  build and no way for it to be stale
#   7. the host key               still baked, so a rebuild re-keys and clients
#                                  with a cached known_hosts entry see the
#                                  change. Generated by the build instead of by
#                                  a RUN step, which also means it is not
#                                  regenerated on every container start
{ pkgs, lib, image, tools, configs, targets, imageTargets }:
let
  inherit (lib) makeBinPath attrValues mapAttrs' replaceStrings;

  user = "dev";
  uid = 1000;
  gid = 1000;
  homePath = "/home/dev";

  account = image.account {
    inherit user uid gid;
    group = user;
    home = homePath;
    shell = "/bin/bash";
  };

  # The public roots, at /etc/ssl/certs/ca-certificates.crt where
  # NODE_EXTRA_CA_CERTS, REQUESTS_CA_BUNDLE and OpenSSL all look. The *sandbox*
  # CA is not in the image: it is generated per machine and gitignored, so a
  # flake cannot see it, and naming sandbox/ca/ would pull the private key into
  # the store (audit S2). It is bind-mounted read-only and appended to this
  # bundle by devbox-init at every container start.
  caTrustStore = image.caTrustStore;

  # The config tree, at its deploy paths rather than its source paths — the
  # same target table the host uses, so there is one list of where things go.
  #
  # `builtins.toFile` writes the string the config layer produced into the store
  # with no shell and no escaping rule in the way, which is the reason that
  # layer reads files instead of pasting them into ''...'' strings. `cp -rL`
  # below then copies real files, not symlinks into the store, so a user can
  # edit one without a read-only filesystem.
  configTree = pkgs.linkFarm "devbox-config" (
    mapAttrs' (source: target: {
      name = target;
      value = builtins.toFile (replaceStrings [ "/" " " ] [ "-" "-" ] target) configs.${source};
    }) (targets // imageTargets)
  );

  # sshd's host key, baked as a build artifact — problem 7 above. That makes the
  # image non-reproducible by design, exactly as the old one was.
  hostKey = pkgs.runCommand "devbox-ssh-host-key"
    { nativeBuildInputs = [ pkgs.openssh ]; } ''
    export HOME=$TMPDIR
    mkdir -p $out
    ssh-keygen -q -t ed25519 -N "" -C "devbox host key" \
      -f $out/ssh_host_ed25519_key
  '';

  # /home/dev, assembled here and owned by dev once the layer is tarred.
  homeTree = pkgs.runCommand "devbox-home" { } ''
    mkdir -p $out/.ssh/sshd $out/.local/bin

    cp -rL ${configTree}/. $out/

    cp ${../../sandbox/dev/sshd-init.sh} $out/.local/bin/sshd-init
    cp ${../../sandbox/dev/devbox-init.sh} $out/.local/bin/devbox-init
    cp ${hostKey}/ssh_host_ed25519_key $out/.ssh/sshd/ssh_host_ed25519_key

    chmod 0755 $out/.local/bin/sshd-init $out/.local/bin/devbox-init
    chmod 0700 $out/.ssh $out/.ssh/sshd
    chmod 0600 $out/.ssh/sshd/sshd_config $out/.ssh/sshd/ssh_host_ed25519_key
    chmod 0644 $out/.bashrc
  '';

  closure = image.rootClosure (
    (attrValues tools)
    ++ [
      pkgs.bashInteractive
      pkgs.coreutils # date, sleep, dircolors, lesspipe
      pkgs.findutils
      pkgs.gawk
      pkgs.gnugrep
      pkgs.gnused
      pkgs.git # jj, jjui, lazygit and workmux all shell out to it
      pkgs.less
      pkgs.lesspipe
      pkgs.openssh # sshd and ssh-keygen
      pkgs.which
      homeTree
    ]
  );
in
image.layeredImage {
  name = "localhost/sandbox-devbox";
  contents = [ closure account caTrustStore ];
  inherit uid gid;

  extraCommands = ''
    mkdir -p usr/local/bin
    cp ${homeTree}/.local/bin/sshd-init usr/local/bin/sshd-init
    cp ${homeTree}/.local/bin/devbox-init usr/local/bin/devbox-init
    chmod 0755 usr/local/bin/sshd-init usr/local/bin/devbox-init
    cp -r ${account}/etc/. etc/
    cp -r ${caTrustStore}/etc/. etc/
  '';

  env = [
    "HOME=${homePath}"
    "PATH=${makeBinPath (attrValues tools)}"
    "USER=${user}"
    # The config tree assumes a truecolour terminal, which this image cannot
    # advertise; the bashrc exports COLORTERM for the tools that honour it
    # (pi, jjui, opencode, leaf).
    "COLORTERM=truecolor"
    # Node ships its own roots instead of reading the system store, and Python's
    # requests uses certifi. Both are pointed back at the bundle, which holds
    # the public roots plus the sandbox CA.
    "NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt"
    "REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt"
  ];

  user = user;

  # The container is started with the sshd sequence instead; see
  # sandbox/quadlet/sandbox-devbox.container. The image's own CMD is an
  # interactive bash, which is what `podman run` without arguments gives you.
  entrypoint = [ "/bin/bash" ];
}